# Copy this file to .env and fill in your values for local development.
# .env is gitignored and should never be committed.

# Snowflake connection (role needs read access to RAW_ENGCA_DEV)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=

# Snowflake Cortex LLM model names (availability varies by region).
# Validated for this app: LOW=openai-gpt-5-mini, MED=claude-4-sonnet
LLM_MODEL_LOW="CHOOSE_A_SMALL_MODEL"
LLM_MODEL_MED="CHOOSE_A_MEDIUM_MODEL"
LLM_MODEL_HIGH="CHOOSE_A_LARGE_MODEL"
