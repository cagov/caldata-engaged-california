# Copy this file to .env and fill in your values for local development.
# .env is gitignored and should never be committed.

# Snowflake connection (role needs read access to the analytics schema below)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=

# Location of the pre-tagged dbt tables (phase2_zoom_transcripts_and_chats,
# phase2_transcript_session_summaries). Defaults target production; override for dev,
# e.g. DISCUSSIONS_DATABASE=analytics_engca_dev, DISCUSSIONS_SCHEMA=dbt_<you>_ai_engagement
DISCUSSIONS_DATABASE="analytics_engca_prd"
DISCUSSIONS_SCHEMA="ai_engagement"

# Snowflake Cortex LLM model names — only used by the on-demand Quote search and
# Custom analysis tabs (the Session summary and theme tags are pre-computed by dbt).
# Availability varies by region. Validated for this app: LOW=openai-gpt-5-mini, MED=claude-4-sonnet
LLM_MODEL_LOW="CHOOSE_A_SMALL_MODEL"
LLM_MODEL_MED="CHOOSE_A_MEDIUM_MODEL"
LLM_MODEL_HIGH="CHOOSE_A_LARGE_MODEL"
