# Copy this file to .env and fill in your values for local development.
# .env is gitignored and should never be committed.

# Snowflake connection (role needs read access to the analytics schema below)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=

# Location of the pre-tagged dbt tables (phase2_transcript_curated_theme_tags,
# phase2_zoom_transcripts_and_chats, phase2_sessions, phase2_speaker_ai_survey).
# Same variable names as the ai_impact_discussions app, so one .env can serve both.
# Defaults target production; override for dev, e.g.
# DISCUSSIONS_DATABASE=analytics_engca_dev, DISCUSSIONS_SCHEMA=dbt_<you>_ai_engagement
DISCUSSIONS_DATABASE="analytics_engca_prd"
DISCUSSIONS_SCHEMA="ai_engagement"

# No LLM_MODEL_* variables: this app makes zero live Cortex calls — all theme tags
# are pre-computed by the dbt pipeline.
